  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "typebox": "1.4.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.59.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geril07/pi-goal.git"
  }
